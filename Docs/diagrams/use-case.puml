@startuml use-case
' FundTrail use case diagram. EPIC-001 / T3 (#8).
' Source: SRS (Docs/srs.md) §2.3 and §5, with the review changes requested on #63.
' Render: java -jar plantuml.jar -tpng Docs/diagrams/use-case.puml

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actorStyle default

actor "Kavindu\n(User)" as User
cloud "Firebase\nAuthentication" as Auth
database "Cloud\nFirestore" as Store
node "Android OS\n(notifications,\nconnectivity)" as OS

rectangle "FundTrail Android app" {
  usecase "UC-11 Sign up, sign in,\nsign out" as UC11
  usecase "UC-12 Manage accounts" as UC12
  usecase "UC-13 Manage categories" as UC13
  usecase "UC-01 Quick-add expense" as UC01
  usecase "UC-02 Confirm salary\nreceived" as UC02
  usecase "UC-03 Track freelance\nmilestone" as UC03
  usecase "UC-04 Record AdSense\npayout" as UC04
  usecase "UC-05 Record crypto\nresult" as UC05
  usecase "UC-06 Record transfer\n(incl. adding to goal)" as UC06
  usecase "UC-09 Review recurring\ncosts" as UC09
  usecase "UC-08 Manage savings goal\n(linked savings account)" as UC08
  usecase "UC-07 Check dashboard" as UC07
  usecase "UC-14 Browse history" as UC14
  usecase "UC-10 Catch up after\na gap" as UC10
  usecase "UC-15 Manage settings\nand data" as UC15

  usecase "Confirm income\nEXPECTED → ACTUAL" as INC
  usecase "Suggest category" as SUG
  usecase "Show goal cost" as COST
  usecase "Check goal feasibility" as FEAS
  usecase "Sync data\noffline-first" as SYNC
}

User -- UC11
User -- UC12
User -- UC13
User -- UC01
User -- UC02
User -- UC03
User -- UC04
User -- UC05
User -- UC06
User -- UC09
User -- UC08
User -- UC07
User -- UC14
User -- UC10
User -- UC15

UC02 ..> INC : <<include>>
UC03 ..> INC : <<include>>
UC04 ..> INC : <<include>>
UC01 ..> SUG : <<include>>
COST ..> UC01 : <<extend>>\n[discretionary expense]
UC08 ..> FEAS : <<include>>
UC10 ..> UC01 : <<include>>

UC11 -- Auth
UC15 -- Auth
SYNC -- Store
SYNC -- OS
UC03 -- OS
UC09 -- OS
UC15 -- OS

note right of SYNC
  Included by every use case that
  reads or writes data (edges omitted).
  Writes go to Firestore's local cache
  and sync later; Room mirrors Firestore.
end note
@enduml
